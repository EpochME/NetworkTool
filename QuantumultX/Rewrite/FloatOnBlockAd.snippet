[rewrite_local]
# 悬浮精灵 (FloatOn) 去开屏弹窗广告
^https?:\/\/cs\.kuso\.xyz\/configs url script-response-body https://raw.githubusercontent.com/EpochME/NetworkTool/refs/heads/main/QuantumultX/Script/FloatOn.js
^https?:\/\/cs\.kuso\.xyz\/application url reject-200

# 屏蔽穿山甲/Pangle 广告请求（可选，防止后续广告位生效）
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com url reject-200
^https?:\/\/sf\d+-fe-tos\.pglstatp-toutiao\.com url reject-200
^https?:\/\/dm\.toutiao\.com\/get_domains url reject-200

[mitm]
hostname = cs.kuso.xyz, api-access.pangolin-sdk-toutiao.com, *.pglstatp-toutiao.com, dm.toutiao.com